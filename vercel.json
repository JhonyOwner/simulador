{
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/simulador",
      "destination": "/api/simulador"
    },
    {
      "source": "/simulador.html",
      "destination": "/api/simulador"
    }
  ]
}
